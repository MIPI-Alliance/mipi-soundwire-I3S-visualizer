# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual environments
.venv/
venv/
env/

# Build output (PyInstaller top-level build/dist, CMake native/build, wheels)
build/
dist/
*.whl

# Native CMake artifacts (intermediate build output)
native/build/

# Built native extension module — a platform/Python-specific BUILD PRODUCT, not
# source. Build it with `pip install ./native` (or native/build_local.sh, which
# drops it here). Committing it would only ever work for one OS + Python version.
/swi3score*.so
/swi3score*.pyd
/swi3score*.dylib

# macOS
.DS_Store

# Editors / IDEs
.vscode/
.idea/
*.swp

# Local scratch: ad-hoc diagnostic/investigation scripts. NOT the test suite —
# that lives in tests/ (plural). Kept out of the repo.
/scratch/
/test/

# Local capture data + working configs (not part of the repo). The app reads a
# user-supplied init.csv / bus_config.csv from the repo root if present, else the
# built-in demo config.
*.bin
*.wav
*.sal
/bus_config.csv
/init.csv
/frame_model.json          # "Save Bus Model…" JSON export (scratch, app-generated)

# render-and-look output (tools/shots.py)
/shots/

# Local dev scratch + rendered screenshots (not part of the project)
scratch/
shots/

# Generated by tools/viz_report.py (regenerate on demand)
tests/visualizer/summary.md
tests/visualizer/previous_stats.json

# Local-only working notes: session logs, review transcripts, one-off analyses,
# probe scripts. Tier 0 — never committed to any remote. See docs/DEVELOPMENT.md.
dev_docs/

# Coverage artefacts. `.coverage` is a binary database that a `git add -A` right after a
# coverage run WILL sweep into the tree — it did, in 3.0.13, and reached a pushed commit
# before the tier test caught it. The gate could not: it lists TRACKED files, and the file
# was untracked at gate time and tracked by the very `git add -A` that followed.
.coverage
.coverage.*
coverage.xml
htmlcov/
