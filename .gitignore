# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual environments, as a directory or as a symlink to one (no trailing slash, which would
# match only a directory)
.venv
venv
env/

# Build output (PyInstaller top-level build/dist, CMake native/build, wheels)
build/
dist/
*.whl

# Built native extension module — a platform/Python-specific BUILD PRODUCT, not
# source. Build it with `pip install ./native` (or native/build_local.sh, which
# drops it here). Committing it would only ever work for one OS + Python version.
/swi3score*.so
/swi3score*.pyd
/swi3score*.dylib

# macOS
.DS_Store

# Editors / IDEs
.vscode/
.idea/
*.swp

# Local scratch: ad-hoc diagnostic/investigation scripts, and rendered screenshots. NOT the
# test suite — that lives in tests/ (plural). Kept out of the repo.
scratch/
/test/
shots/

# Local capture data + working configs (not part of the repo). The app reads a
# user-supplied init.csv from the repo root if present, else the built-in demo config.
# bus_config.csv and bus_model.json are the default names of the authoring CSV and the
# Export Bus Model (JSON) file.
*.bin
*.wav
*.sal
/bus_config.csv
/init.csv
/bus_model.json

# Local-only working notes: session logs, review transcripts, one-off analyses,
# probe scripts. Tier 0 — never committed to any remote. See docs/DEVELOPMENT.md.
dev_docs/

# Coverage artefacts. `.coverage` is a binary database: never commit it.
.coverage
.coverage.*
coverage.xml
htmlcov/
